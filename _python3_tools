#compdef python3
_python3_tools_completion() {
    local context state state_descr line
    typeset -A opt_args
    
    if [[ $CURRENT -ge 2 && ${words[2]} == "tools.py" ]]; then
        local f_flag_pos=0
        for ((i=1; i<=$#words; i++)); do
            if [[ "${words[i]}" == "-f" ]]; then
                f_flag_pos=$i
                break
            fi
        done
        
        if [[ $f_flag_pos -gt 0 && $CURRENT -gt $f_flag_pos ]]; then
            _complete_folders
            return $?
        fi
    fi
    
    _files
}

_complete_folders() {
    local target_dir="./mix/output"
    
    if [[ ! -d "$target_dir" ]]; then
        _message "错误: 目录 $target_dir 不存在"
        return 1
    fi
    
    local selected_folders=()
    local f_flag_pos=0
    
    for ((i=1; i<=$#words; i++)); do
        if [[ "${words[i]}" == "-f" ]]; then
            f_flag_pos=$i
            break
        fi
    done
    
    if [[ $f_flag_pos -gt 0 ]]; then
        for ((i=f_flag_pos+1; i<$CURRENT; i++)); do
            if [[ -n "${words[i]}" && "${words[i]}" != -* ]]; then
                selected_folders+=("${words[i]}")
            fi
        done
    fi
    
    local folders=()
    local folder_descriptions=()
    
    for item in "$target_dir"/*(/N); do
        if [[ -d "$item" ]]; then
            local folder_name="${item:t}"
            
            local already_selected=false
            for selected in "${selected_folders[@]}"; do
                if [[ "$selected" == "$folder_name" ]]; then
                    already_selected=true
                    break
                fi
            done
            
            if [[ "$already_selected" == false ]]; then
                folders+=("$folder_name")
                folder_descriptions+=("$folder_name:$target_dir 中的文件夹")
            fi
        fi
    done
    
    if [[ ${#folders} -eq 0 ]]; then
        if [[ ${#selected_folders} -gt 0 ]]; then
            _message "所有文件夹都已选择"
        else
            _message "在 $target_dir 中未找到任何文件夹"
        fi
        return 1
    fi
    
    local -a compadd_opts
    
    _describe -t folders 'output文件夹' folder_descriptions
    
    return 0
}

compdef _python3_tools_completion python3
